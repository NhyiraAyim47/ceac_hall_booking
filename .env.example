# ─────────────────────────────────────────────────────────────
#  CEAC Hall Booking - environment settings
#  Copy this file to ".env" and fill in your real values.
#  NEVER upload ".env" to a public place or share it.
# ─────────────────────────────────────────────────────────────
APP_NAME="CEAC Hall Booking"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

# ── Database (MySQL / MariaDB) ───────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ceac_booking
DB_USERNAME=root
DB_PASSWORD=

# ── Sessions / cache (no extra tables needed) ────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=60
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=ceac_session
SESSION_SAME_SITE=strict
# Set to true when the site runs on https:// (production)
SESSION_SECURE_COOKIE=false

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# ── Email (Gmail SMTP with an "App Password") ────────────────
# Create a NEW app password in your Google account (Security > 2-Step
# Verification > App passwords) and paste it below. Keep it secret.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=hallbookingceac@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hallbookingceac@gmail.com
MAIL_FROM_NAME="CEAC Hall Booking"

# Public contact email shown on the website
CEAC_EMAIL=hallbookingceac@gmail.com

# Proxies whose X-Forwarded-For header is trusted (visitor IP for rate
# limiting). "*" is fine behind Cloudflare / shared-hosting proxies.
TRUSTED_PROXIES=*
